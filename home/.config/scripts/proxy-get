#!/usr/bin/env bun

const PROXY_LISTS = [
  {
    url: "https://raw.githubusercontent.com/ProxyScrape/free-proxy-list/main/proxies/all/data.txt",
    stripScheme: true,
  },
  {
    url: "https://raw.githubusercontent.com/xyzs996/free-proxy-health-list/main/socks5.txt",
    stripScheme: false,
  },
];

const CHECK_URL = "https://example.com/";
const TARGET_COUNT = 10;
const BATCH_SIZE = 64;
const PARALLELISM = 32;
const CURL = Bun.which("curl");

if (!CURL) {
  console.error("proxy-get: required command not found: curl");
  process.exit(1);
}

const activeDownloads = new Set();
const activeChecks = new Set();
let interrupted = false;

function stopActiveWork(signal) {
  for (const controller of activeDownloads) controller.abort();
  for (const child of activeChecks) child.kill(signal);
}

function handleSignal(signal) {
  if (interrupted) return;

  interrupted = true;
  process.exitCode = signal === "SIGINT" ? 130 : 143;
  stopActiveWork(signal);
}

process.on("SIGINT", () => handleSignal("SIGINT"));
process.on("SIGTERM", () => handleSignal("SIGTERM"));

async function downloadList(url) {
  const controller = new AbortController();
  activeDownloads.add(controller);
  const timeout = setTimeout(() => controller.abort(), 30_000);

  try {
    const response = await fetch(url, { signal: controller.signal });
    if (!response.ok) throw new Error(`${url} returned HTTP ${response.status}`);
    return await response.text();
  } finally {
    clearTimeout(timeout);
    activeDownloads.delete(controller);
  }
}

function isValidEndpoint(endpoint) {
  const [host, port, ...extra] = endpoint.split(":");
  return extra.length === 0 &&
    /^[a-zA-Z0-9.-]+$/.test(host) &&
    /^\d+$/.test(port) &&
    Number(port) >= 1 && Number(port) <= 65535;
}

function parseCandidates(text, stripScheme) {
  const candidates = [];

  for (const line of text.split("\n")) {
    let endpoint = line.trim().split(/\s+/, 1)[0] ?? "";

    if (stripScheme) {
      if (!endpoint.startsWith("socks5://")) continue;
      endpoint = endpoint.slice("socks5://".length);
    }

    if (isValidEndpoint(endpoint)) candidates.push(endpoint);
  }

  return candidates;
}

function shuffle(items) {
  for (let index = items.length - 1; index > 0; index--) {
    const other = Math.floor(Math.random() * (index + 1));
    [items[index], items[other]] = [items[other], items[index]];
  }
  return items;
}

async function isWorkingProxy(endpoint) {
  if (interrupted) return false;

  const check = Bun.spawn([
    CURL, "-q", "-fsS", "--noproxy", "",
    "--connect-timeout", "3", "--max-time", "8",
    "--proxy", `socks5h://${endpoint}`,
    CHECK_URL, "-o", "/dev/null",
  ], {
    stdin: "ignore",
    stdout: "ignore",
    stderr: "ignore",
  });
  activeChecks.add(check);

  try {
    return await check.exited === 0;
  } finally {
    activeChecks.delete(check);
  }
}

async function checkBatch(batch) {
  const working = [];
  let next = 0;

  async function worker() {
    while (!interrupted) {
      const endpoint = batch[next++];
      if (endpoint === undefined) return;
      if (await isWorkingProxy(endpoint)) working.push(endpoint);
    }
  }

  const workerCount = Math.min(PARALLELISM, batch.length);
  await Promise.all(Array.from({ length: workerCount }, worker));
  return working;
}

async function main() {
  const lists = await Promise.all(PROXY_LISTS.map(({ url }) => downloadList(url)));
  const candidates = [...new Set(lists.flatMap((list, index) =>
    parseCandidates(list, PROXY_LISTS[index].stripScheme),
  ))];
  shuffle(candidates);

  let found = 0;
  for (let start = 0; start < candidates.length && found < TARGET_COUNT; start += BATCH_SIZE) {
    const batch = candidates.slice(start, start + BATCH_SIZE);
    const working = await checkBatch(batch);

    for (const endpoint of working) {
      if (found === TARGET_COUNT) break;
      console.log(endpoint);
      found++;
    }
  }

  if (interrupted) return;
  if (found !== TARGET_COUNT) {
    console.error(`proxy-get: found ${found} working SOCKS5 proxies; need ${TARGET_COUNT}`);
    process.exitCode = 1;
  }
}

main().catch((error) => {
  if (interrupted) return;
  interrupted = true;
  stopActiveWork("SIGTERM");
  console.error(`proxy-get: ${error instanceof Error ? error.message : error}`);
  process.exitCode = 1;
});


#!/usr/bin/env bun

const PROXY_LISTS = [
  {
    url: "https://raw.githubusercontent.com/ProxyScrape/free-proxy-list/main/proxies/all/data.txt",
    scheme: true,
  },
  {
    url: "https://raw.githubusercontent.com/xyzs996/free-proxy-health-list/main/socks5.txt",
    scheme: false,
  },
];

const CHECK_URL = "https://example.com/";
const CHECKS_PER_LIST = 10;
const LIST_TIMEOUT_MS = 30_000;
const CHECK_TIMEOUT_SECONDS = 8;

const args = process.argv.slice(2);
const outputCountText = args[0];
const outputCount = outputCountText === undefined ? 16 : Number(outputCountText);

if (
  args.length > 1 ||
  (outputCountText !== undefined && !/^\d+$/.test(outputCountText)) ||
  !Number.isSafeInteger(outputCount)
) {
  console.error("Usage: proxy-get [outputCount: non-negative integer]");
  process.exit(2);
}

if (outputCount === 0) process.exit(0);

const CURL = Bun.which("curl");

if (!CURL) {
  console.error("proxy-get: required command not found: curl");
  process.exit(1);
}

const activeDownloads = new Set();
const activeChecks = new Set();
let finished = false;
let foundCount = 0;

function stopActiveWork(signal = "SIGTERM") {
  if (finished) return;
  finished = true;

  for (const controller of activeDownloads) controller.abort();
  for (const check of activeChecks) check.kill(signal);
}

function handleSignal(signal) {
  if (finished) return;

  process.exitCode = signal === "SIGINT" ? 130 : 143;
  stopActiveWork(signal);
}

process.on("SIGINT", () => handleSignal("SIGINT"));
process.on("SIGTERM", () => handleSignal("SIGTERM"));

async function downloadList(url) {
  const controller = new AbortController();
  activeDownloads.add(controller);
  const timeout = setTimeout(() => controller.abort(), LIST_TIMEOUT_MS);

  try {
    const response = await fetch(url, { signal: controller.signal });
    if (!response.ok) throw new Error(`${url} returned HTTP ${response.status}`);
    return await response.text();
  } finally {
    clearTimeout(timeout);
    activeDownloads.delete(controller);
  }
}

function parseCandidates(text, includesScheme) {
  const candidates = [];

  for (const line of text.split(/\r?\n/)) {
    const endpoint = line.trim().split(/\s+/, 1)[0] ?? "";
    if (!endpoint || endpoint.startsWith("#")) continue;

    candidates.push(includesScheme ? endpoint : `socks5://${endpoint}`);
  }

  return candidates;
}

async function isWorkingProxy(proxy) {
  if (finished) return false;

  let check;

  try {
    check = Bun.spawn([
      CURL,
      "-q",
      "-fsS",
      "--noproxy",
      "",
      "--connect-timeout",
      "3",
      "--max-time",
      String(CHECK_TIMEOUT_SECONDS),
      "--proxy",
      proxy,
      "--output",
      "/dev/null",
      CHECK_URL,
    ], {
      stdin: "ignore",
      stdout: "ignore",
      stderr: "ignore",
    });
    activeChecks.add(check);
    return await check.exited === 0 && !finished;
  } catch {
    return false;
  } finally {
    if (check) activeChecks.delete(check);
  }
}

function reportWorkingProxy(proxy) {
  if (finished || foundCount >= outputCount) return;

  console.log(proxy);
  foundCount++;

  if (foundCount >= outputCount) stopActiveWork();
}

async function checkList(list) {
  let candidates;

  try {
    candidates = parseCandidates(await downloadList(list.url), list.scheme);
  } catch (error) {
    if (!finished) {
      console.error(`proxy-get: ${error instanceof Error ? error.message : error}`);
    }
    return;
  }

  let nextCandidate = 0;

  async function worker() {
    while (!finished) {
      const proxy = candidates[nextCandidate++];
      if (proxy === undefined) return;

      if (await isWorkingProxy(proxy)) reportWorkingProxy(proxy);
    }
  }

  const workerCount = Math.min(CHECKS_PER_LIST, candidates.length);
  await Promise.all(Array.from({ length: workerCount }, worker));
}

await Promise.all(PROXY_LISTS.map(checkList));

if (!finished && foundCount < outputCount) {
  console.error(`proxy-get: found ${foundCount} working proxies; requested ${outputCount}`);
  process.exitCode = 1;
}
